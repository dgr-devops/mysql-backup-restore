# /etc/systemd/system/mysql-backup@.service — una instancia por base de datos: mysql-backup@tienda.service
# Instalación:
#   sudo install -m 644 deploy/mysql-backup@.service /etc/systemd/system/mysql-backup@.service
#   sudo install -m 644 deploy/mysql-backup@.timer   /etc/systemd/system/mysql-backup@.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now mysql-backup@tienda.timer
[Unit]
Description=Copia lógica de MySQL (%i)
Wants=network-online.target
After=network-online.target mysql.service

[Service]
Type=oneshot
User=backup
Group=backup
Environment=MYSQL_DEFAULTS_FILE=/etc/mysql-backup/backup.cnf
Environment=BACKUP_DIR=/var/backups/mysql
Environment=KEEP_COPIES=14
Environment=KEEP_DAYS=30
ExecStart=/opt/mysql-backup-restore/scripts/mysql-backup.sh -d %i
# 0 = copia hecha; 1 = otra copia en curso (se omite, no es un fallo del servicio).
SuccessExitStatus=1
Nice=10
IOSchedulingClass=idle
# Endurecimiento: solo escribe en el directorio de copias.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/mysql
