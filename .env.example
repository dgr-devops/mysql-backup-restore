# Copia este fichero a .env (está en .gitignore) y ajusta los valores.
# Sirve para docker-compose.yml, para los tests y como EnvironmentFile de systemd.
# Los valores de aquí son marcadores de posición: NO uses una clave real en un fichero versionado.

# --- Instancia MySQL de pruebas (docker compose) ---
MYSQL_ROOT_PASSWORD=cambia-esta-clave-solo-local
MYSQL_PORT=33306

# --- Conexión de los scripts (alternativa a -c FICHERO_OPCIONES) ---
# Mejor un fichero de opciones con permisos 600; consulta deploy/backup.example.cnf.
# MYSQL_DEFAULTS_FILE=/etc/mysql-backup/backup.cnf
# MYSQL_HOST=127.0.0.1
# MYSQL_USER=backup
# MYSQL_PWD=

# --- Política de copias ---
# MYSQL_DATABASE=tienda
# BACKUP_DIR=/var/backups/mysql
# KEEP_COPIES=7
# KEEP_DAYS=0
